{
  "title": {
    "description": "图片标题",
    "type": "string",
    "default": "系统状态"
  },
  "background_mode": {
    "description": "背景类型",
    "type": "string",
    "options": [
      "none",
      "url",
      "file"
    ],
    "default": "none"
  },
  "background_url": {
    "description": "背景图片 URL",
    "type": "string",
    "default": ""
  },
  "background_file": {
    "description": "背景图片本地路径",
    "type": "string",
    "default": ""
  },
  "text_color": {
    "description": "文字颜色",
    "type": "string",
    "default": "#ffffff"
  },
  "accent_color": {
    "description": "强调色 / 进度条颜色",
    "type": "string",
    "default": "#6366f1"
  },
  "theme": {
    "description": "主题模板",
    "type": "string",
    "options": [
      "custom_dashboard",
      "dark_glass",
      "light_card",
      "neon"
    ],
    "default": "custom_dashboard"
  },
  "background_fit": {
    "description": "背景填充模式",
    "type": "string",
    "options": [
      "cover",
      "contain",
      "fill"
    ],
    "default": "cover"
  },
  "enable_session_config": {
    "description": "允许会话级配置覆盖",
    "type": "bool",
    "default": false
  },
  "auto_background": {
    "description": "当填写 URL 或文件时自动启用背景",
    "type": "bool",
    "default": true
  },
  "width": {
    "description": "逻辑布局宽度",
    "type": "int",
    "default": 960
  },
  "height": {
    "description": "逻辑布局高度",
    "type": "int",
    "default": 1760
  },
  "render_scale": {
    "description": "高清渲染倍数",
    "type": "int",
    "default": 3
  },
  "show_cpu": {
    "description": "显示 CPU",
    "type": "bool",
    "default": true
  },
  "show_memory": {
    "description": "显示内存",
    "type": "bool",
    "default": true
  },
  "show_disk": {
    "description": "显示磁盘",
    "type": "bool",
    "default": true
  },
  "disk_partitions": {
    "description": "指定显示的磁盘挂载点列表",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": []
  },
  "show_hostname": {
    "description": "显示主机名",
    "type": "bool",
    "default": true
  },
  "show_time": {
    "description": "显示当前时间",
    "type": "bool",
    "default": true
  },
  "locale": {
    "description": "界面语言",
    "type": "string",
    "options": [
      "zh",
      "en"
    ],
    "default": "zh"
  },
  "force_show_empty_disk": {
    "description": "无分区数据时仍显示磁盘卡片",
    "type": "bool",
    "default": true
  },
  "show_network": {
    "description": "显示网络速率",
    "type": "bool",
    "default": true
  },
  "network_interfaces": {
    "description": "指定显示的网卡列表",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": []
  },
  "show_swap": {
    "description": "显示 Swap",
    "type": "bool",
    "default": true
  },
  "show_top_processes": {
    "description": "显示进程榜单",
    "type": "bool",
    "default": true
  },
  "top_n": {
    "description": "进程榜单数量",
    "type": "int",
    "default": 10
  },
  "show_os": {
    "description": "显示系统信息",
    "type": "bool",
    "default": true
  },
  "show_uptime": {
    "description": "显示运行时长",
    "type": "bool",
    "default": true
  },
  "show_disk_total": {
    "description": "显示磁盘总览",
    "type": "bool",
    "default": true
  },
  "show_network_per_iface": {
    "description": "逐项显示各网卡速率",
    "type": "bool",
    "default": false
  },
  "footer_position": {
    "description": "页脚位置",
    "type": "string",
    "options": [
      "left_bottom",
      "right_bottom"
    ],
    "default": "left_bottom"
  },
  "bar_color_cpu": {
    "description": "CPU 进度条颜色",
    "type": "string",
    "default": "#6366f1"
  },
  "bar_color_mem": {
    "description": "内存进度条颜色",
    "type": "string",
    "default": "#6366f1"
  },
  "bar_color_swap": {
    "description": "Swap 进度条颜色",
    "type": "string",
    "default": "#6366f1"
  },
  "bar_color_net": {
    "description": "网络进度条颜色",
    "type": "string",
    "default": "#6366f1"
  },
  "bar_color_disk": {
    "description": "磁盘进度条颜色",
    "type": "string",
    "default": "#6366f1"
  },
  "bottom_right_panel": {
    "description": "右下角附加面板",
    "type": "string",
    "options": [
      "none",
      "net_ifaces",
      "processes",
      "summary",
      "deep_host"
    ],
    "default": "processes"
  },
  "process_sort_key": {
    "description": "进程排序依据",
    "type": "string",
    "options": [
      "memory",
      "cpu"
    ],
    "default": "cpu"
  },
  "process_show_user": {
    "description": "显示进程用户",
    "type": "bool",
    "default": true
  },
  "enable_deep_host_metrics": {
    "description": "??????????",
    "type": "bool",
    "default": true
  },
  "show_battery_card": {
    "description": "??????",
    "type": "bool",
    "default": true
  },
  "show_temperature_card": {
    "description": "??????",
    "type": "bool",
    "default": true
  },
  "show_gpu_card": {
    "description": "?? GPU ??",
    "type": "bool",
    "default": true
  },
  "show_container_card": {
    "description": "??????",
    "type": "bool",
    "default": true
  },
  "alert_gpu_percent": {
    "description": "GPU ?????0 ????",
    "type": "int",
    "default": 95
  },
  "alert_temperature_c": {
    "description": "????????????0 ????",
    "type": "int",
    "default": 85
  },
  "alert_battery_percent": {
    "description": "Battery alert threshold while discharging, 0 to disable",
    "type": "int",
    "default": 0
  },
  "alert_container_stopped": {
    "description": "Stopped container count threshold, 0 to disable",
    "type": "int",
    "default": 0
  },
  "enable_system_history": {
    "description": "开启本地系统历史采样",
    "type": "bool",
    "default": true
  },
  "show_system_history_panel": {
    "description": "在主看板中显示系统历史趋势",
    "type": "bool",
    "default": true
  },
  "history_sample_minutes": {
    "description": "本地历史采样间隔（分钟）",
    "type": "int",
    "default": 5
  },
  "history_retention_hours": {
    "description": "历史采样保留时长（小时）",
    "type": "int",
    "default": 72
  },
  "history_chart_hours": {
    "description": "趋势图默认展示窗口（小时）",
    "type": "int",
    "default": 24
  },
  "history_chart_points": {
    "description": "趋势图最大采样点数",
    "type": "int",
    "default": 36
  },
  "history_alert_context_hours": {
    "description": "告警附加趋势文脉的回看时间（小时）",
    "type": "int",
    "default": 1
  },
  "alert_cpu_percent": {
    "description": "CPU 告警阈值，0 表示禁用",
    "type": "int",
    "default": 85
  },
  "alert_memory_percent": {
    "description": "内存告警阈值，0 表示禁用",
    "type": "int",
    "default": 90
  },
  "alert_disk_percent": {
    "description": "磁盘告警阈值，按总览或最高分区判断，0 表示禁用",
    "type": "int",
    "default": 90
  },
  "alert_swap_percent": {
    "description": "Swap 告警阈值，0 表示禁用",
    "type": "int",
    "default": 80
  },
  "alert_cooldown_minutes": {
    "description": "告警重复发送冷却分钟数",
    "type": "int",
    "default": 120
  },
  "alert_send_recovery": {
    "description": "指标恢复后发送恢复提示",
    "type": "bool",
    "default": true
  },
  "alert_with_image": {
    "description": "触发告警时附带系统状态图片",
    "type": "bool",
    "default": true
  },
  "sysinfo_alert_help": {
    "description": "阈值告警命令说明",
    "type": "string",
    "default": "请在群聊中使用 /sysinfo_alert <分钟> 开启阈值告警，输入 status 查看当前会话状态，输入 off 关闭。告警阈值由插件配置决定。"
  },
  "sysinfo_auto_help": {
    "description": "定时发送说明",
    "type": "string",
    "default": "请在群聊中使用 /sysinfo_auto <分钟> 开启定时发送，数据会自动保存。"
  }
}
